# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.
#
# Calendar feed (ICS) URLs. Any CALENDAR_<NAME>_URL var is picked up on first
# run and added as a calendar; after that, manage calendars in the app's
# Calendars dialog. These links grant read access to anyone who has them, so
# treat them like passwords.

CALENDAR_WORK_URL=
CALENDAR_MEETINGS_URL=

# Display timezone and the timezone weekly goals reset in.
APP_TZ=Australia/Sydney

# Port the local server listens on.
PORT=4321

# Where the SQLite database lives (defaults to ./data).
# HABIT_DATA_DIR=
